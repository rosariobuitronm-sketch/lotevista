{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.env.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/hosts.yml)",

      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.env.local)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/secrets/**)",
      "Edit(**/credentials/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.config/gh/hosts.yml)",

      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(del /s*)",
      "Bash(del * /s*)",
      "Bash(format *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git clean -df*)",

      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(more *.env*)",
      "Bash(less *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(Get-Content *.env*)",
      "Bash(source *.env*)",
      "Bash(. *.env*)",
      "PowerShell(cat *.env*)",
      "PowerShell(type *.env*)",
      "PowerShell(more *.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(gc *.env*)",
      "PowerShell(Select-String *.env*)",

      "PowerShell(Remove-Item *-Recurse*-Force*)",
      "PowerShell(Remove-Item *-Force*-Recurse*)",
      "PowerShell(rm *-Recurse*-Force*)",
      "PowerShell(rm *-Force*-Recurse*)",
      "PowerShell(del /s*)",
      "PowerShell(del * /s*)",
      "PowerShell(format *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean -fd*)",
      "PowerShell(git clean -df*)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",

      "Bash(vercel deploy*)",
      "Bash(vercel --prod*)",
      "Bash(vercel * --prod*)",
      "PowerShell(vercel deploy*)",
      "PowerShell(vercel --prod*)",
      "PowerShell(vercel * --prod*)",

      "Bash(rm *)",
      "Bash(del *)",
      "Bash(rmdir *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "PowerShell(del *)",
      "PowerShell(rmdir *)",

      "Bash(psql *)",
      "Bash(neon *)",
      "Bash(neonctl *)",
      "PowerShell(psql *)",
      "PowerShell(neon *)",
      "PowerShell(neonctl *)"
    ]
  }
}
