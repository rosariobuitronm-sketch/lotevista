# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local a git. Aquí solo van los nombres, sin valores reales.

# Base de datos Neon (rama de la demo)
DATABASE_URL=

# Base de datos Neon (rama exclusiva de pruebas; las pruebas nunca usan la de la demo)
DATABASE_URL_TEST=

# Google Gemini (solo se usa desde el servidor)
GEMINI_API_KEY=
GEMINI_MODEL=

# Secretos de la aplicación (cadenas largas y aleatorias)
AUTH_SECRET=
IP_HASH_SECRET=

# Usuarios de demo del panel del asesor (los usa el script que los crea; se guardan con hash)
ASESOR1_USUARIO=
ASESOR1_PASSWORD=
ASESOR2_USUARIO=
ASESOR2_PASSWORD=
